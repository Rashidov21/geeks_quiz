# Development: DEBUG=True, Production: DEBUG=False
DEBUG=True

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Comma-separated hostnames (no http:// or https://)
ALLOWED_HOSTS=127.0.0.1,localhost,test.pyblog.uz,www.test.pyblog.uz

# Telegram — yangi test natijasi guruhga yuboriladi (ixtiyoriy)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
